{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NetScope", "version": "0.0.0", "identifier": "dev.lordlabs.netscope",
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devUrl": "http://localhost:1420", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "label": "main", "title": "NetScope", "width": 1100, "height": 760, "minWidth": 320, "minHeight": 480 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self'; connect-src 'self' ipc: http://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'none'; frame-src 'none'"
    }
  },
  "bundle": { "active": false, "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"] }
}
